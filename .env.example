# ──────────────────────────────────────────────────────────────
# Kopieer naar .env en vul aan:   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Publieke adres van de site (gebruikt in links in e-mails). Zonder slash op het einde.
PUBLIC_URL=https://bijles.example.be
# Poort op je homeserver waarop de site luistert (zet je reverse proxy hierheen)
WEB_PORT=8080
SITE_NAME=Bijlesplatform

# Database (gebruik enkel letters en cijfers in het wachtwoord)
POSTGRES_DB=bijles
POSTGRES_USER=bijles
POSTGRES_PASSWORD=verander-mij-naar-iets-langs

# Geheime sleutel voor inlogsessies, minstens 32 tekens.
# Genereer er een met:  openssl rand -hex 32
SESSION_SECRET=

# Startwachtwoord voor Yeno en Reda bij de allereerste start (daarna wijzigen via Beheer → Profiel)
ADMIN_INITIAL_PASSWORD=

# ── Bijlesgevers ──
TUTOR_YENO_EMAIL=roelantsyeno@gmail.com
TUTOR_REDA_EMAIL=reda.kadi07@gmail.com
# WhatsApp-nummers (ook later aan te passen in Beheer → Profiel). Leeg = geen WhatsApp-knop.
TUTOR_YENO_WHATSAPP=
TUTOR_REDA_WHATSAPP=

# ── E-mail (SMTP) ──
# Leeg laten = mails worden enkel in de logs getoond, niet verstuurd.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=jouw@gmail.com, SMTP_PASS=<app-wachtwoord>
# Lokaal testen met Mailpit (--profile dev): SMTP_HOST=mailpit, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bijlesplatform <jouw-adres@gmail.com>
# Als iemand op een mail antwoordt, gaat het antwoord rechtstreeks naar Yeno of Reda
MAIL_REPLY_TO_TUTOR=true

# ── Privacy ──
PRIVACY_CONTROLLER_NAME=Yeno Roelants en Reda Kadi
PRIVACY_CONTACT_EMAIL=roelantsyeno@gmail.com
# Datum van de laatste wijziging van de privacyverklaring (JJJJ-MM-DD)
PRIVACY_VERSION=2026-11-05

# ── Bewaartermijnen ──
RETENTION_MONTHS=12
RETENTION_CLOSED_MONTHS=3
RETENTION_WAITLIST_MONTHS=12
RETENTION_OUTBOX_DAYS=30

# ── Herinneringen ──
# Herinnering de dag voor de les wordt verstuurd vanaf dit uur (lokale tijd)
REMINDER_HOUR=17
# Bijlesgever krijgt een herinnering als een aanvraag zo lang onbeantwoord blijft
NUDGE_AFTER_HOURS=24
NUDGE_URGENT_AFTER_HOURS=4
